#!/bin/sh
echo '[SMS] Starting system initialization...'

mount -t proc none /proc
mount -t sysfs none /sys
mount -t tmpfs none /tmp
mount -t devtmpfs none /dev 2>/dev/null || true
mkdir -p /dev/mqueue
mount -t mqueue none /dev/mqueue 2>/dev/null || true

[ -c /dev/console ] || mknod /dev/console c 5 1
[ -c /dev/null ] || mknod /dev/null c 1 3
[ -c /dev/zero ] || mknod /dev/zero c 1 5

hostname sms-board
echo sms-board > /proc/sys/kernel/hostname

if [ -f /lib/modules/5.15.0/sms_sensor_driver.ko ]; then
    if insmod /lib/modules/5.15.0/sms_sensor_driver.ko; then
        echo '[SMS] sms_sensor_driver loaded OK'
    else
        echo '[SMS] WARNING: sms_sensor_driver failed to load; continuing boot'
    fi
else
    echo '[SMS] WARNING: sms_sensor_driver.ko not found; continuing boot'
fi

echo '[SMS] System initialization complete!'
echo ' -> run: sms_app -d 10 -v'